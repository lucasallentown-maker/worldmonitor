# Copy is created by scripts/local-backend/up.mjs as .env.local-backend (gitignored, mode 0600).
# Generate values locally. Do not commit real tokens.
#
#   REDIS_PASSWORD=$(openssl rand -hex 32)
#   REDIS_TOKEN=$(openssl rand -hex 32)
#
# The REST proxy and Redis listen on 127.0.0.1 only. Do not publish 6379 or 8079.

UPSTASH_REDIS_REST_URL=http://127.0.0.1:8079
UPSTASH_REDIS_REST_TOKEN=replace-with-openssl-rand-hex-32
WM_API_BASE=http://127.0.0.1:3000

# Optional provider keys. Leave unset rather than inventing values.
# FRED_API_KEY is not read by seed-fear-greed.mjs; that seeder only reads FRED
# series that another seeder has already written. Without it, liquidity, credit,
# and macro stay at the producer's neutral score and are not labeled degraded.
# ALPHA_VANTAGE_API_KEY lets seed-commodity-quotes prefer Alpha Vantage. Yahoo
# chart data is the fallback and does not need a key.
# FRED_API_KEY=
# ALPHA_VANTAGE_API_KEY=
